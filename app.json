{
  "name": "Moshabot",
  "description": "Hii ni bot rasmi ya Gilbert Mosha iliyotengenezwa kwa ajili ya kurahisisha matumizi ya WhatsApp.",
  "keywords": [
    "bot",
    "whatsapp",
    "Moshabot",
    "whatsapp-stickers",
    "anime",
    "whatsapp-bot",
    "whatsapp-sticker-bot",
    "whatsapp-botto",
    "baileys",
    "baileys-md",
    "md-bot"
  ],
  "website": "https://github.com/GILBERTmosha/Moshabot",
  "repository": "https://github.com/GILBERTmosha/Moshabot",
  "logo": "https://files.catbox.moe/jxeidh.png",
  "success_url": "/",
  "env": {
    "SESSION": {
      "description": "Weka Session ID yako hapa",
      "required": true
    },
    "OWNER_NUMBER": {
      "description": "Namba ya mmiliki (Mfano: 254793770731)",
      "value": "254793770731",
      "required": true
    },
    "DATABASE_URL": {
      "description": "PostgreSQL database URL (optional)",
      "required": false
    },
    "BOT_NAME": {
      "description": "Jina la Bot",
      "value": "Moshabot",
      "required": false
    },
    "PREFIX": {
      "description": "Alama ya kuanzia amri",
      "value": ".",
      "required": false
    },
    "MODE": {
      "description": "Bot mode: public au private",
      "value": "public",
      "required": false
    },
    "PACKNAME": {
      "description": "Jina la sticker pack",
      "value": "Moshabot Stickers",
      "required": false
    },
    "TIMEZONE": {
      "description": "Timezone",
      "value": "Africa/Dar_es_Salaam",
      "required": false
    },
    "AUTHOR": {
      "description": "Jina la mmiliki",
      "value": "Gilbert Mosha",
      "required": false
    },
    "DEVICE_MODE": {
      "description": "Device mode: Android (full features)",
      "value": "Android",
      "required": true
    },
    "ANTI_CALL": {
      "description": "Kukata simu otomatiki",
      "value": "on",
      "required": false
    },
    "ANTI_CALL_ACTION": {
      "description": "Action: reject au block",
      "value": "reject",
      "required": false
    },
    "ANTI_CALL_MSG": {
      "description": "Ujumbe baada ya kukata simu",
      "value": "Moshabot is busy, please call later.",
      "required": false
    },
    "ANTI_DELETE": {
      "description": "Kuzuia kufutwa kwa meseji",
      "value": "on",
      "required": false
    },
    "AUTO_STATUS_VIEW": {
      "description": "Kutazama status otomatiki",
      "value": "on",
      "required": false
    },
    "STATUS_REPLY_MSG": {
      "description": "Ujumbe wa status reply",
      "value": "Nice status! Viewed by Moshabot",
      "required": false
    },
    "BOT_URL": {
      "description": "Link ya picha ya menu",
      "value": "https://files.catbox.moe/jxeidh.png",
      "required": false
    }
  },
  "buildpacks": [
    {
      "url": "https://github.com/heroku/heroku-buildpack-nodejs.git"
    }
  ],
  "stack": "heroku-24"
}
